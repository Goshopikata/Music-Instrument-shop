@{
    ViewData["Title"] = "Instrument Maintenance";
}

<div class="container mt-5 d-flex justify-content-center">
    <div class="card shadow-lg p-5" style="max-width: 1000px; border-radius: 20px; background-color: #ffffff;">
        <div class="text-center mb-4">
            <h1 class="display-5 fw-bold">Instrument Maintenance Services</h1>
            <p class="lead">Professional care for your musical instruments, ensuring top performance and longevity.</p>
        </div>

        <div class="text-center mb-4">
            <img src="https://i.ytimg.com/vi/M_cl_z4ZC28/sddefault.jpg"
                 alt="Instrument Maintenance"
                 class="img-fluid rounded-4 shadow-sm"
                 style="height: 400px; width: 100%; object-fit: cover;">
        </div>

        <div class="bg-light p-4 rounded-4 shadow-sm mb-4">
            <h3 class="mb-3 text-primary text-center">Location & Contact</h3>
            <p class="mb-2 text-center"><strong>📍 Address:</strong> g.k. Belite brezi, ul. "Vorino" 52, 1680 Sofia</p>
            <p class="mb-2 text-center"><strong>📞 Phone:</strong> 088 446 4049</p>
            <p class="mb-0 text-center"><strong>⏰ Opening Hours:</strong> 9:00 AM – 7:00 PM</p>
        </div>

        <div class="bg-light p-4 rounded-4 shadow-sm mb-4">
            <h3 class="mb-3 text-primary text-center">Our Services</h3>
            <ul class="list-group list-group-flush">
                <li class="list-group-item text-center">🎻 Violin repair</li>
                <li class="list-group-item text-center">🎸 Setup of guitars and basses</li>
                <li class="list-group-item text-center">🎹 Key repair</li>
                <li class="list-group-item text-center">🎵 String replacement</li>
                <li class="list-group-item text-center">🛠️ Crack repair</li>
                <li class="list-group-item text-center">🎨 Retouch</li>
                <li class="list-group-item text-center">🔧 Repair of broken parts</li>
                <li class="list-group-item text-center">🎻 Violin restoration</li>
                <li class="list-group-item text-center">🎻 Violin and viola repairs</li>
                <li class="list-group-item text-center">🎨 Violin varnishing</li>
            </ul>
        </div>

        <div class="text-center">
            <a href="/Maintenance/BookService" class="btn btn-lg btn-primary rounded-pill px-5 py-2">
                Book a Service
            </a>
        </div>
    </div>
</div>
