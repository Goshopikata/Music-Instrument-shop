@{
    ViewData["Title"] = "Music School";
}

<div class="container mt-5 d-flex justify-content-center">
    <div class="card shadow-lg p-5" style="max-width: 1000px; border-radius: 20px; background-color: #ffffff;">
        <div class="text-center mb-4">
            <h1 class="display-5 fw-bold">Welcome to Our Music School</h1>
            <p class="lead">Master your instrument with guidance from top instructors!</p>
        </div>

        <div class="text-center mb-4">
            <img src="https://citymusic-school.com/wp-content/uploads/2019/09/DSC_0195-1-e1569772101197.jpg"
                 alt="Music School Building"
                 class="img-fluid rounded-4 shadow-sm"
                 style="height: 400px; width: 100%; object-fit: cover;">
        </div>

        <div class="bg-light p-4 rounded-4 shadow-sm mb-4">
            <h3 class="mb-3 text-primary text-center">Contact Information</h3>
            <p class="mb-2 text-center"><strong>📍 Address:</strong> 123 Music Avenue, Harmony City, 4000</p>
            <p class="mb-2 text-center"><strong>📞 Phone:</strong> 087 655 9965</p>
            <p class="mb-0 text-center"><strong>⏰ Opening Hours:</strong> 8:00 AM – 8:00 PM</p>
        </div>

        

        <div class="bg-light p-4 rounded-4 shadow-sm">
            <h3 class="mb-4 text-primary text-center">Available Lessons</h3>

            <div class="row">
                @foreach (var instrument in new[] { "Guitar", "Electric Guitar", "Bass", "Drums", "Violin", "Harp", "Saxophone", "Trumpet", "Accordion", "Flute", "Cello", "Piano" })
                {
                    <div class="col-md-6 mb-4">
                        <div class="card h-100 shadow-sm border-0 rounded-4">
                            <div class="card-body text-center">
                                <h4 class="card-title text-primary">@instrument Lessons</h4>
                                <ul class="list-unstyled mt-3">
                                    <li><span class="badge bg-success">Beginner</span></li>
                                    <li><span class="badge bg-warning text-dark">Intermediate</span></li>
                                    <li><span class="badge bg-danger">Experienced</span></li>
                                </ul>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

    </div>
</div>
