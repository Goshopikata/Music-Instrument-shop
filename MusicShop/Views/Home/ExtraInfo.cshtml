@{
    ViewBag.Title = "Information";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - Instrument Information</title>
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
    <style>
        
        body {
            font-family: Arial, sans-serif;
            background-color: #f8f9fa;
            color: #343a40;
            margin: 0;
            padding: 0;
        }
        .container {
            margin-top: 50px;
            margin-bottom: 50px;
        }
        h1 {
            color: #007bff;
        }
        p {
            font-size: 18px;
            line-height: 1.6;
        }
    </style>
</head>
<body>
    <div class="container">
        <h1 class="text-center">Welcome to Our music instrument shop Service</h1>
        <p>
            
        <hr>
        <h2 class="text-center">Why Choose Us?</h2>
        <p>
            There are many reasons to choose instrumental service:
        </p>
        <ul>
            <li>We offer competitive prices and flexible buying options to suit your budget and schedule.</li>
            <li>We provide 24/7 customer support to address any questions.</li>
            
        </ul>
       
    </div>

    

    <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.bundle.min.js"></script>
</body>
</html>
