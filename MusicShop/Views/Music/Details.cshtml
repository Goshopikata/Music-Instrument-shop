@using MusicShop.Services.Instruments.Models

@model InstrumentDetailsServiceModel

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-10">
            <div class="d-flex align-items-start gap-4 p-4 shadow rounded bg-light">
                <img src="@Model.ImageUrl" alt="Instrument Image" class="img-fluid rounded" style="max-width: 18rem; margin-right: 2rem;" />

                <div class="w-100">
                    <div class="p-3 mb-3 border rounded bg-white">
                        <h3 class="mb-2">@Model.Brand @Model.Model</h3>
                    </div>

                    <div class="p-3 mb-3 border rounded bg-white">
                        <p class="text-muted mb-1"><strong>Brand:</strong> @Model.Brand</p>
                    </div>

                    <div class="p-3 mb-3 border rounded bg-white">
                        <p class="text-muted mb-1"><strong>Category:</strong> @Model.CategoryName</p>
                    </div>

                    <div class="p-3 mb-3 border rounded bg-white">
                        <p class="mb-1"><strong>Description:</strong></p>
                        <p class="mt-2">@Model.Description</p>
                    </div>

                    <div class="p-3 mb-3 border rounded bg-white">
                        <p class="mb-1"><strong>Price:</strong> @Model.Price</p>
                        
                    </div>

                    <a asp-area="" asp-controller="Music" asp-action="Buy" class="btn btn-lg btn-green-outline shadow-sm rounded-pill px-5 py-2">
                        <i class="bi bi-cart-fill me-2"></i> Buy Now
                    </a>

                </div>
            </div>
        </div>
    </div>
</div>
