@using MusicShop.Services.Instruments.Models
@model IEnumerable<InstrumentServiceModel>

@{
    ViewBag.Title = "My Instruments";
    ViewBag.AllowCarEdit = true;
}

@if (!Model.Any())
{
    <h2 class="text-center mb-4">You don't have any instruments yet!</h2>
}
else
{
    <partial name="_InstrumentsPartial" model="@Model" />
}
