@using MusicShop
@using MusicShop.Infrastructure.Extensions

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - Best shop for musical instruments </title>
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
    <link rel="stylesheet" href="~/css/site.css" />
    <style>
        .nav-box {
            background-color: #f8f9fa;
            border: 1px solid #ced4da;
            border-radius: 6px;
            margin: 0 4px;
            padding: 3px 10px;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            font-size: 16px;
            transition: background-color 0.2s ease;
        }

            .nav-box:hover {
                background-color: #e2e6ea;
            }

        .navbar-brand {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .dropdown-menu a.dropdown-item {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-md navbar-light bg-light border-bottom box-shadow mb-3">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index" style="font-size: 22px;">Soundwave</a>
                <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarCollapse"
                        aria-controls="navbarCollapse" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarCollapse">
                    <ul class="navbar-nav mr-auto d-flex align-items-center">
                        @if (!User.IsAdmin())
                        {
                            <li class="nav-item dropdown nav-box">
                                <a class="nav-link dropdown-toggle text-dark" href="#" id="instrumentsDropdown" role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                    Instruments
                                </a>
                                <div class="dropdown-menu" aria-labelledby="instrumentsDropdown">
                                    <a class="dropdown-item" asp-area="" asp-controller="Music" asp-action="Add">Add Instrument</a>
                                    <a class="dropdown-item" asp-area="" asp-controller="Music" asp-action="Mine">My Instruments</a>
                                    <a class="dropdown-item" asp-area="" asp-controller="Music" asp-action="All">All Instruments</a>
                                </div>
                            </li>
                        }
                        <li class="nav-item nav-box">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Service" asp-action="Index">Service</a>
                        </li>
                        <li class="nav-item nav-box">
                            <a class="nav-link text-dark" asp-area="" asp-controller="MusicSchool" asp-action="Index">Music School</a>
                        </li>
                        <li class="nav-item nav-box">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Maintenance" asp-action="Index">Maintenance</a>
                        </li>
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        @if (TempData.ContainsKey(WebConstants.GlobalMessageKey))
        {
            <div class="alert alert-success text-center" role="alert">
                @TempData[WebConstants.GlobalMessageKey]
            </div>
        }
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted bg-light">
    </footer>
    <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
